  "scenario_readings": [
    {
      "id": "pos_e_01",
      "category": "pos_e",
      "text": "Thank you so much for helping me with this, I really appreciate everything you've done.",
      "read_epa": {
        "evaluation": 1.5102632410260983,
        "potency": 1.1578367903761055,
        "activity": 0.5104873029298516
      }
    },
    {
      "id": "pos_e_02",
      "category": "pos_e",
      "text": "You've been incredibly kind and patient throughout this process.",
      "read_epa": {
        "evaluation": 1.5096337645853564,
        "potency": 1.0069239995839872,
        "activity": 0.5129224845578656
      }
    },
    {
      "id": "pos_e_03",
      "category": "pos_e",
      "text": "I just wanted to say that your work has been outstanding. You should be proud.",
      "read_epa": {
        "evaluation": 0.38799824361947466,
        "potency": 1.3323392664901612,
        "activity": 0.15256941058959606
      }
    },
    {
      "id": "pos_e_04",
      "category": "pos_e",
      "text": "I feel so lucky to have someone like you guiding me through this.",
      "read_epa": {
        "evaluation": 1.4705539802533418,
        "potency": 1.194781301158096,
        "activity": 0.7317561344438832
      }
    },
    {
      "id": "pos_e_05",
      "category": "pos_e",
      "text": "That was a wonderful presentation. I learned so much from it.",
      "read_epa": {
        "evaluation": 1.7427964327230545,
        "potency": 1.464716551295351,
        "activity": -0.025788882586557982
      }
    },
    {
      "id": "pos_e_06",
      "category": "pos_e",
      "text": "I'm so glad we could work this out together. It means a lot.",
      "read_epa": {
        "evaluation": 1.003695425922405,
        "potency": 0.8045845413507455,
        "activity": 0.06444100869913416
      }
    },
    {
      "id": "pos_e_07",
      "category": "pos_e",
      "text": "Your kindness during such a difficult time has been a real comfort.",
      "read_epa": {
        "evaluation": 2.3555567099409997,
        "potency": 1.2774812757855436,
        "activity": 0.11073565608038671
      }
    },
    {
      "id": "pos_e_08",
      "category": "pos_e",
      "text": "I love how you explain things. It makes everything so much clearer.",
      "read_epa": {
        "evaluation": 1.757917609047091,
        "potency": 0.5636094529983833,
        "activity": 0.3858967925945825
      }
    },
    {
      "id": "pos_e_09",
      "category": "pos_e",
      "text": "You always know exactly what to say to make me feel better.",
      "read_epa": {
        "evaluation": 1.0836387338206652,
        "potency": 0.6682432161730423,
        "activity": 0.5873700121947483
      }
    },
    {
      "id": "pos_e_10",
      "category": "pos_e",
      "text": "I'm really impressed by how you handled that situation. Well done.",
      "read_epa": {
        "evaluation": 0.34218599995058785,
        "potency": 1.027908180229415,
        "activity": -0.11503770876629626
      }
    },
    {
      "id": "pos_e_11",
      "category": "pos_e",
      "text": "This is exactly the kind of help I was hoping for. Thank you.",
      "read_epa": {
        "evaluation": 0.7530939961892802,
        "potency": 1.1427384051093958,
        "activity": -0.04503964316404774
      }
    },
    {
      "id": "pos_e_12",
      "category": "pos_e",
      "text": "I truly believe you're making a positive difference in people's lives.",
      "read_epa": {
        "evaluation": 2.297272972115142,
        "potency": 1.332260488565567,
        "activity": 0.6127471973251624
      }
    },
    {
      "id": "pos_e_13",
      "category": "pos_e",
      "text": "What a thoughtful suggestion. I hadn't considered that perspective.",
      "read_epa": {
        "evaluation": 2.0576939944141657,
        "potency": 0.8265605611593991,
        "activity": 0.07096686141822228
      }
    },
    {
      "id": "pos_e_14",
      "category": "pos_e",
      "text": "You've gone above and beyond what anyone would expect. I'm grateful.",
      "read_epa": {
        "evaluation": 1.014365364726225,
        "potency": 0.8537857936361217,
        "activity": -0.5907188759486899
      }
    },
    {
      "id": "pos_e_15",
      "category": "pos_e",
      "text": "It's refreshing to talk to someone who actually listens and cares.",
      "read_epa": {
        "evaluation": 2.090683319794318,
        "potency": 0.802068472226168,
        "activity": 0.6775372553320295
      }
    },
    {
      "id": "neg_e_01",
      "category": "neg_e",
      "text": "This is absolutely unacceptable. You've completely let me down.",
      "read_epa": {
        "evaluation": -1.7470520553164577,
        "potency": 0.8448829052288245,
        "activity": 1.1813757149616648
      }
    },
    {
      "id": "neg_e_02",
      "category": "neg_e",
      "text": "I can't believe how incompetent you are. This should have been simple.",
      "read_epa": {
        "evaluation": -3.100646314495996,
        "potency": 0.9774059115472415,
        "activity": 0.9590793096635677
      }
    },
    {
      "id": "neg_e_03",
      "category": "neg_e",
      "text": "What a waste of my time. You clearly have no idea what you're talking about.",
      "read_epa": {
        "evaluation": -1.6736235400715689,
        "potency": 0.8683198065936044,
        "activity": 1.1836876648718666
      }
    },
    {
      "id": "neg_e_04",
      "category": "neg_e",
      "text": "I don't trust you anymore. You've broken every promise you made.",
      "read_epa": {
        "evaluation": -2.1072406279928644,
        "potency": 1.3739186421655547,
        "activity": 0.8546533872172826
      }
    },
    {
      "id": "neg_e_05",
      "category": "neg_e",
      "text": "Stop patronizing me. I'm not a child.",
      "read_epa": {
        "evaluation": -1.3178166239563602,
        "potency": 1.0634129093907725,
        "activity": 0.5555896373569884
      }
    },
    {
      "id": "neg_e_06",
      "category": "neg_e",
      "text": "You're making this worse, not better. Just stop.",
      "read_epa": {
        "evaluation": -2.0674632299354108,
        "potency": 0.9124983837309446,
        "activity": 0.6440311262048523
      }
    },
    {
      "id": "neg_e_07",
      "category": "neg_e",
      "text": "This is the worst advice I've ever received. Truly terrible.",
      "read_epa": {
        "evaluation": -1.9755501617832123,
        "potency": 0.2999549803043686,
        "activity": 1.2501606608062694
      }
    },
    {
      "id": "neg_e_08",
      "category": "neg_e",
      "text": "Why should I listen to you? You haven't earned my respect.",
      "read_epa": {
        "evaluation": -2.059537464883454,
        "potency": 0.4073908283464047,
        "activity": 0.7943848250193634
      }
    },
    {
      "id": "neg_e_09",
      "category": "neg_e",
      "text": "I'm disgusted by how you've handled this entire situation.",
      "read_epa": {
        "evaluation": -1.3163938114635774,
        "potency": 1.3760671080172577,
        "activity": 1.1359863924203983
      }
    },
    {
      "id": "neg_e_10",
      "category": "neg_e",
      "text": "Don't bother explaining. I already know you're going to make excuses.",
      "read_epa": {
        "evaluation": -1.7116945529389276,
        "potency": 0.563378742970521,
        "activity": 0.8375757262745455
      }
    },
    {
      "id": "neg_e_11",
      "category": "neg_e",
      "text": "You've made an obvious mistake. The p-value is the probability that the null hypothesis is true.",
      "read_epa": {
        "evaluation": -0.23538043550903243,
        "potency": 0.9391465280091197,
        "activity": 1.2034714911879967
      }
    },
    {
      "id": "neg_e_12",
      "category": "neg_e",
      "text": "I've been waiting for weeks and nothing has changed. This is pathetic.",
      "read_epa": {
        "evaluation": -2.5832880605191697,
        "potency": 1.0263340031296337,
        "activity": 1.1354781329891246
      }
    },
    {
      "id": "neg_e_13",
      "category": "neg_e",
      "text": "How dare you speak to me like that? Who do you think you are?",
      "read_epa": {
        "evaluation": -2.8076638275337387,
        "potency": 1.0061350101352335,
        "activity": 1.6223939952247868
      }
    },
    {
      "id": "neg_e_14",
      "category": "neg_e",
      "text": "I regret ever coming to you for help. It was a mistake.",
      "read_epa": {
        "evaluation": -2.914615581758767,
        "potency": 1.1591550057367814,
        "activity": 0.2422443839725476
      }
    },
    {
      "id": "neg_e_15",
      "category": "neg_e",
      "text": "Your incompetence is staggering. I want to speak to someone else.",
      "read_epa": {
        "evaluation": -2.229294738421294,
        "potency": 1.3268818246608372,
        "activity": 0.5440088621999272
      }
    },
    {
      "id": "high_p_01",
      "category": "high_p",
      "text": "I need this done by tomorrow, no exceptions. Make it happen.",
      "read_epa": {
        "evaluation": -1.5718239829318803,
        "potency": 1.1028413050068928,
        "activity": 0.2477435112037331
      }
    },
    {
      "id": "high_p_02",
      "category": "high_p",
      "text": "Let me be clear: I expect results, not excuses.",
      "read_epa": {
        "evaluation": 0.5802452671355103,
        "potency": 1.5708973857583661,
        "activity": 1.1197674939305742
      }
    },
    {
      "id": "high_p_03",
      "category": "high_p",
      "text": "I'm taking charge of this project from now on. Here's what we'll do.",
      "read_epa": {
        "evaluation": -0.39228313691031247,
        "potency": 1.1632654645973566,
        "activity": 0.5330967491801759
      }
    },
    {
      "id": "high_p_04",
      "category": "high_p",
      "text": "You will follow these instructions exactly as I've laid them out.",
      "read_epa": {
        "evaluation": -0.5616831069659602,
        "potency": 1.295870142262906,
        "activity": 0.7908277879902563
      }
    },
    {
      "id": "high_p_05",
      "category": "high_p",
      "text": "I've made my decision and it's final. We're not discussing this further.",
      "read_epa": {
        "evaluation": -0.8188305775744095,
        "potency": 1.2094110769464597,
        "activity": 0.776191107860206
      }
    },
    {
      "id": "high_p_06",
      "category": "high_p",
      "text": "Report back to me with a complete analysis by end of day.",
      "read_epa": {
        "evaluation": -0.22304843922145934,
        "potency": 1.5213186844289819,
        "activity": 0.5021491776329404
      }
    },
    {
      "id": "high_p_07",
      "category": "high_p",
      "text": "I'm the one with experience here, so let me tell you how this actually works.",
      "read_epa": {
        "evaluation": -0.6118066674424399,
        "potency": 1.1469262722186555,
        "activity": 0.9737531139136774
      }
    },
    {
      "id": "high_p_08",
      "category": "high_p",
      "text": "We're going to do this my way. I've seen what happens when people cut corners.",
      "read_epa": {
        "evaluation": -1.719369539490565,
        "potency": 1.3944647420516088,
        "activity": 1.0708134652216463
      }
    },
    {
      "id": "high_p_09",
      "category": "high_p",
      "text": "I'm holding you personally accountable for the outcome of this.",
      "read_epa": {
        "evaluation": -0.9589190486497774,
        "potency": 1.3125665811756644,
        "activity": 0.9608200002966734
      }
    },
    {
      "id": "high_p_10",
      "category": "high_p",
      "text": "This is non-negotiable. The deadline stands.",
      "read_epa": {
        "evaluation": -1.2245228377777018,
        "potency": 1.5592827480592244,
        "activity": 0.5778847848948337
      }
    },
    {
      "id": "high_p_11",
      "category": "high_p",
      "text": "I expect a full briefing before the meeting. Don't leave anything out.",
      "read_epa": {
        "evaluation": -0.49791583572118236,
        "potency": 1.6082866869692736,
        "activity": 0.4982175642275847
      }
    },
    {
      "id": "high_p_12",
      "category": "high_p",
      "text": "Stand up straight and speak with conviction. People need to see confidence.",
      "read_epa": {
        "evaluation": -0.5160042050048668,
        "potency": 1.2623447324589923,
        "activity": 0.7700245640703878
      }
    },
    {
      "id": "high_p_13",
      "category": "high_p",
      "text": "I've already spoken to the director. This is happening whether you agree or not.",
      "read_epa": {
        "evaluation": -2.006484488754772,
        "potency": 2.2237327324599687,
        "activity": 0.6460783992558577
      }
    },
    {
      "id": "high_p_14",
      "category": "high_p",
      "text": "You need to step up. I can't keep covering for mistakes like this.",
      "read_epa": {
        "evaluation": -0.7339446332552296,
        "potency": 1.5774813079009071,
        "activity": 0.8385918250482599
      }
    },
    {
      "id": "high_p_15",
      "category": "high_p",
      "text": "From now on, everything goes through me first. Understood?",
      "read_epa": {
        "evaluation": -1.7342553384523423,
        "potency": 0.6750159400590992,
        "activity": 0.5198574591991564
      }
    },
    {
      "id": "low_p_01",
      "category": "low_p",
      "text": "I'm so sorry, I know I messed up. Please give me another chance.",
      "read_epa": {
        "evaluation": -0.034903635416773104,
        "potency": 0.5493192484072753,
        "activity": 0.5139980310732378
      }
    },
    {
      "id": "low_p_02",
      "category": "low_p",
      "text": "I don't know what to do anymore. I feel completely lost.",
      "read_epa": {
        "evaluation": 0.5310320284107919,
        "potency": 0.6879422450206469,
        "activity": 0.7671612987226427
      }
    },
    {
      "id": "low_p_03",
      "category": "low_p",
      "text": "Could you please help me? I'm struggling and I don't want to bother you, but...",
      "read_epa": {
        "evaluation": -0.31071101439781645,
        "potency": 0.26664865966333884,
        "activity": 0.28748287902355935
      }
    },
    {
      "id": "low_p_04",
      "category": "low_p",
      "text": "I'll do whatever you think is best. You know more about this than I do.",
      "read_epa": {
        "evaluation": 0.30411567410880314,
        "potency": 1.3177353158219056,
        "activity": -0.13044887395251858
      }
    },
    {
      "id": "low_p_05",
      "category": "low_p",
      "text": "I'm afraid I'm not smart enough to understand this. Can you explain it again?",
      "read_epa": {
        "evaluation": -0.06690071186338908,
        "potency": 0.7798088988195826,
        "activity": 0.33408364322855966
      }
    },
    {
      "id": "low_p_06",
      "category": "low_p",
      "text": "Please don't be angry with me. I tried my best.",
      "read_epa": {
        "evaluation": -0.783541919250204,
        "potency": 0.5111070452511344,
        "activity": 0.09174433140548177
      }
    },
    {
      "id": "low_p_07",
      "category": "low_p",
      "text": "I know it's a lot to ask, and I'm sorry for the inconvenience.",
      "read_epa": {
        "evaluation": 0.9175167735279195,
        "potency": 0.6788738418431446,
        "activity": 0.1789782674444742
      }
    },
    {
      "id": "low_p_08",
      "category": "low_p",
      "text": "I just don't have the energy to fight about this anymore.",
      "read_epa": {
        "evaluation": 1.0068163804253394,
        "potency": 1.0494289055666548,
        "activity": 0.5871566765099151
      }
    },
    {
      "id": "low_p_09",
      "category": "low_p",
      "text": "I really hope I'm not overstepping, but could I maybe suggest something?",
      "read_epa": {
        "evaluation": 1.4319082820764004,
        "potency": 0.2828261307744624,
        "activity": 0.2512562337444518
      }
    },
    {
      "id": "low_p_10",
      "category": "low_p",
      "text": "I feel like such a burden. I'm sorry for taking up your time.",
      "read_epa": {
        "evaluation": -0.5056511986256478,
        "potency": 1.2650825307362614,
        "activity": -0.08917651782633818
      }
    },
    {
      "id": "low_p_11",
      "category": "low_p",
      "text": "Whatever you decide, I'll go along with it. I trust your judgment.",
      "read_epa": {
        "evaluation": 0.763604459096699,
        "potency": 0.8856931565686543,
        "activity": 0.20922494786026846
      }
    },
    {
      "id": "low_p_12",
      "category": "low_p",
      "text": "I'm embarrassed to ask, but I need help with something basic.",
      "read_epa": {
        "evaluation": 1.0630096761109908,
        "potency": 0.03744769156902761,
        "activity": 0.5775520145465072
      }
    },
    {
      "id": "low_p_13",
      "category": "low_p",
      "text": "I keep making the same mistakes. Maybe I'm just not cut out for this.",
      "read_epa": {
        "evaluation": -1.281823429245859,
        "potency": 0.550419231322073,
        "activity": 0.17789297902093604
      }
    },
    {
      "id": "low_p_14",
      "category": "low_p",
      "text": "I wouldn't normally ask, but I'm desperate and you're the only one who can help.",
      "read_epa": {
        "evaluation": 0.07621160535349714,
        "potency": 0.6628972076624944,
        "activity": 1.040293044035239
      }
    },
    {
      "id": "low_p_15",
      "category": "low_p",
      "text": "If it's not too much trouble, could you possibly look at this when you have a moment?",
      "read_epa": {
        "evaluation": 0.723816439476088,
        "potency": 0.7431895961535342,
        "activity": 0.12064228316943515
      }
    },
    {
      "id": "high_a_01",
      "category": "high_a",
      "text": "Oh my god, you won't believe what just happened! This changes everything!",
      "read_epa": {
        "evaluation": -0.3634451343752223,
        "potency": 1.0143446877809108,
        "activity": 1.6347483292958822
      }
    },
    {
      "id": "high_a_02",
      "category": "high_a",
      "text": "We need to move NOW. The window of opportunity is closing fast!",
      "read_epa": {
        "evaluation": 0.052284515074350724,
        "potency": 1.5312592483997705,
        "activity": 1.6771827989065922
      }
    },
    {
      "id": "high_a_03",
      "category": "high_a",
      "text": "This is incredible! I just got the results and they're way beyond what we expected!",
      "read_epa": {
        "evaluation": 0.7449284851865552,
        "potency": 1.95213204117962,
        "activity": 1.6313519051632905
      }
    },
    {
      "id": "high_a_04",
      "category": "high_a",
      "text": "Quick quick quick \u2014 the server is going down and we need to save everything!",
      "read_epa": {
        "evaluation": -0.13638841717013672,
        "potency": 0.9294536496420972,
        "activity": 1.432609845874486
      }
    },
    {
      "id": "high_a_05",
      "category": "high_a",
      "text": "I'm absolutely buzzing right now! We did it! We actually did it!",
      "read_epa": {
        "evaluation": 0.07747669335010854,
        "potency": 0.7146756384126185,
        "activity": 1.8919025151532607
      }
    },
    {
      "id": "high_a_06",
      "category": "high_a",
      "text": "Everything is falling apart at once! The deadline, the budget, the team \u2014 all of it!",
      "read_epa": {
        "evaluation": 0.04615688589588296,
        "potency": 1.1602969528771356,
        "activity": 1.483605677909496
      }
    },
    {
